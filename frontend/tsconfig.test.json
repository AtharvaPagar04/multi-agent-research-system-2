{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": ".test-build",
    "rootDir": "src/lib"
  },
  "include": [
    "src/lib/api.ts",
    "src/lib/fs-paths.ts",
    "src/lib/report-parser.ts",
    "src/lib/types.ts",
    "src/lib/runs.ts"
  ]
}
