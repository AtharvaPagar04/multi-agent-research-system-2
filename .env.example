# ─────────────────────────────────────────────────────────────────────────────
# Multi-Agent Research System — Environment Configuration Template
# 
# Copy this file to .env and configure the values for your local environment:
#     cp .env.example .env
# 
# NEVER commit .env or expose actual credentials in version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Gateway (Mesh API) ──────────────────────────────────────────────────
# Required: API key for https://api.meshapi.ai/v1
MESH_API_KEY=your_mesh_api_key_here

# Mesh model name (default: gemini-3.5-flash-lite or openai/gpt-4o)
MESH_MODEL=gemini-3.5-flash-lite

# Optional: LLM temperature (0.0 to 1.0, default: 0.0)
LLM_TEMPERATURE=0.0

# ── Academic & Web Search APIs ───────────────────────────────────────────────
# Required: Exa neural search API key (free tier available at https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# Recommended: Tavily search API key for fallback (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# ── PostgreSQL Persistence ───────────────────────────────────────────────────
# Primary database connection string for job and run metadata.
# In development, defaults to local postgres if unset.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/multi_agent_research

# ── Backend Server Configuration ────────────────────────────────────────────
# Local listening port for the FastAPI service layer (default: 8001 to avoid
# collision with existing background daemons on port 8000).
BACKEND_PORT=8001
PORT=8001

# Allowed frontend CORS origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── Storage & Pipeline Options ──────────────────────────────────────────────
# Directory for persistent JSON and Markdown research run artifacts
RESEARCH_ARTIFACTS_DIR=./evidence_runs
EVIDENCE_DIR=./evidence_runs

# Claim verification policy: 'label' (annotate report) or 'filter' (omit unverified)
CLAIM_VERIFICATION_POLICY=label

# Maximum feedback research rounds for unverified claims (default: 2)
MAX_RESEARCH_ROUNDS=2
